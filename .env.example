# Copy to .env (gitignored) and fill in real values for local dev.
# Run with:  node --env-file=.env server.js

# Neon Postgres connection string (Neon dashboard → your project → Connection string)
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# A SEPARATE Neon branch used only by `npm test` — it gets DROPPED and reseeded on every run.
# Neon dashboard → your project → Branches → New Branch (schema only, no auto-delete) → Connect.
TEST_DATABASE_URL=postgres://user:password@ep-yyyy-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional — leave unset to use the default "gas-admin" (dev only, refuses to boot in production)
ADMIN_PASSCODE=gas-admin
