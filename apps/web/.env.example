# Copy to .env (gitignored) for local `vite dev`. Same idea as apps/api's .dev.vars.

# Clerk dashboard → your application → API Keys → Publishable key. Safe to expose client-side
# (unlike apps/api's CLERK_SECRET_KEY, which must never end up in browser code).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# apps/api's local wrangler dev GraphQL endpoint.
VITE_API_URL=http://localhost:8787/graphql
