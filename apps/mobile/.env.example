# Copy to .env (gitignored) for local `expo start`. Same idea as apps/web's .env.

# Clerk dashboard → your application → API Keys → Publishable key. Safe to expose client-side.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# apps/api's local wrangler dev GraphQL endpoint. A physical device on Expo Go can't reach
# localhost on your machine — use your machine's LAN IP instead, or run against a simulator.
EXPO_PUBLIC_API_URL=http://localhost:8787/graphql
